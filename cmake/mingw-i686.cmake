set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

set(MINGW_PREFIX "i686-w64-mingw32" CACHE STRING "MinGW target prefix")
set(CMAKE_C_COMPILER "${MINGW_PREFIX}-gcc" CACHE FILEPATH "MinGW C compiler")
set(CMAKE_RC_COMPILER "${MINGW_PREFIX}-windres" CACHE FILEPATH "MinGW resource compiler")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
